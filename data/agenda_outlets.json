  "_meta": {
    "purpose": "Curated feed roster for the agenda layer (agenda.py). Selection and prominence capture across the political spectrum plus international outlets and a fact-checker stream.",
    "curated": "2026-06-10",
    "curation_note": "News outlets chosen to span the AllSides spectrum; the lean itself is NEVER stored here — agenda.py resolves each outlet through bias_db (AllSides snapshot) at report time, so every lean is attributable and outlets we can't rate are reported 'unrated', not guessed. Run `python agenda.py --roster` to audit the spectrum balance. International outlets are included for coverage texture even where a US-centric ratings DB cannot rate them. The factcheck stream is used for its SELECTION only (what fact-checkers chose to check is contested-by-construction and claim-shaped); verdicts are never ingested (P1).",
    "feed_choice_note": "Top-stories / homepage feeds preferred: item position in these feeds is the prominence signal. Section feeds are used only where no homepage feed exists.",
    "changelog": [
      "2026-06-11: MSNBC dropped (feed URL serves HTML, no working RSS found) -> Mother Jones (AllSides: Left) keeps the Left bucket at strength.",
      "2026-06-11: CNN dropped — its top-stories feed is a ZOMBIE still serving April-2023 items (caught by the staleness tripwire; would have produced false omission claims) -> NBC News (AllSides: Lean Left).",
      "2026-06-11: Washington Times dropped (403 for non-browser clients) -> The Telegraph (AllSides: Lean Right), which also pairs with The Guardian on the UK axis.",
      "2026-06-11: CBC dropped (persistent read timeouts) -> National Post (Canada; unrated in our AllSides snapshot, counted as international).",
      "2026-06-11: AFP Fact Check dropped (403) -> Full Fact (UK) + Lead Stories (US)."
    ],
    "schema": {
      "key": "stable snake_case id used in snapshots and reports",
      "name": "display name",
      "domain": "registrable domain, for bias_db lookup and link matching",
      "rss": "feed URL",
      "stream": "news | factcheck",
      "country": "ISO-ish country tag, US or other",
      "scope": "feed scope: top-stories | politics | world | factchecks"
    }
  },
